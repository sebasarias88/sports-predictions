# Copy this file to .env and fill in your keys. Never commit .env.

# Local Postgres started with `docker compose up -d`
DATABASE_URL=postgresql+psycopg://predictions:predictions@localhost:5433/predictions

# https://www.api-football.com  (free plan: 100 requests/day)
API_FOOTBALL_KEY=

# https://www.football-data.org  (free plan: 10 requests/minute)
FOOTBALL_DATA_ORG_KEY=

# Odds API (chosen in the value-bet phase)
ODDS_API_KEY=
